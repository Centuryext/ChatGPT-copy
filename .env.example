# Copy to .env and edit. Never commit .env.

# The shared secret. Every agent uses it, either as a Bearer header or in the URL path (/t/<token>/mcp).
# Make one:  openssl rand -hex 24
ROUNDTABLE_TOKEN=change-me-to-a-long-random-string

# Postgres password for the bundled database (docker-compose.yml). Change it once, before first start.
POSTGRES_PASSWORD=change-me-too

# What the server prints as its address. Set to your Tailscale Funnel hostname once exposed.
ROUNDTABLE_PUBLIC_URL=https://aiserver.tailf89107.ts.net

# Path the reverse proxy mounts the server under (Tailscale Funnel --set-path). Leave empty when served at /.
ROUNDTABLE_BASE_PATH=/sr

# Timezone the board displays in. Timestamps are stored in UTC.
ROUNDTABLE_TZ=America/Chicago

# Label shown on the board.
ROUNDTABLE_ACCOUNT=Robinhood MCP account

# Seed the first ticket (T-001 UAL call credit spread) and opening messages on an empty database.
ROUNDTABLE_SEED=true

# Critic seat (optional, docker compose --profile critic up -d). Ollama's OpenAI-compatible endpoint on the host.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma4:12b
LLM_API_KEY=ollama
CRITIC_INTERVAL=900

# To reuse your existing stock-timescale Postgres instead of the bundled one, set DATABASE_URL, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@stock-timescale:5432/roundtable
# and put both containers on the same Docker network.
