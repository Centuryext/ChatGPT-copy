# ---- Copy to voice/.env and fill in. NEVER commit the real .env ----

# Public URL that Twilio can reach (your server). For local testing use an ngrok URL.
# e.g. https://abc123.ngrok.app   (no trailing slash)
PUBLIC_BASE_URL=

# ---- Twilio (create account at twilio.com, then Console shows these) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # the number you buy, E.164 format e.g. +15551234567

# ---- Local LLM (vLLM OpenAI-compatible server on your 5090) ----
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=local             # vLLM ignores this but the client requires a value
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct

# ---- STT (faster-whisper runs in-process on GPU) ----
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ---- TTS (Kokoro) ----
TTS_VOICE=af_heart

# ---- Server ----
PORT=7860

# ---- Database (campaign runner) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callcenter
